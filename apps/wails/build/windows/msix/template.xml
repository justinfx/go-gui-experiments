<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="gguix-wails"
        Arguments=""
        InstallLocation="C:\Program Files\GGUIX\GGUIX - Wails">
    </Installer>
    <PackageInformation
        PackageName="GGUIX - Wails"
        PackageDisplayName="GGUIX - Wails"
        PublisherName="CN=GGUIX"
        PublisherDisplayName="GGUIX"
        Version="0.1.0.0"
        PackageDescription="A gguix-wails application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.gguix.wails"
                Description="A gguix-wails application"
                DisplayName="GGUIX - Wails"
                ExecutableName="gguix-wails"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>GGUIX - Wails</DisplayName>
            <PublisherDisplayName>GGUIX</PublisherDisplayName>
            <Description>A gguix-wails application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="gguix-wails.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
